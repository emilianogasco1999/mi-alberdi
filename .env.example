# ==========================================
# CONFIGURACIÓN GENERAL DEL SISTEMA
# MI ALBERDI — JUAN BAUTISTA ALBERDI
# ==========================================
NODE_ENV=development
PORT_API=4000
PORT_WEB=3000
# URL interna utilizada por Next.js para proxy de /api (SSR y rewrites hacia Express)
# En dev local: http://127.0.0.1:4000 | En Docker prod: http://api:4000
INTERNAL_API_URL=http://127.0.0.1:4000
COMPOSE_FILE=.docker/dev/docker-compose.dev.yml

# ==========================================
# BASE DE DATOS (POSTGRESQL)
# ==========================================
POSTGRES_USER=mialberdi_user
POSTGRES_PASSWORD=mialberdi_password_secret
POSTGRES_DB=mi_alberdi_db
POSTGRES_PORT=5432

# Cadena de conexión para la aplicación (en host local usar localhost; dentro de red Docker usar postgres)
DATABASE_URL=postgresql://mialberdi_user:mialberdi_password_secret@localhost:5432/mi_alberdi_db?schema=public

# ==========================================
# PGADMIN (ADMINISTRADOR DE BASE DE DATOS)
# ==========================================
PGADMIN_EMAIL=admin@mialberdi.com.ar
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ==========================================
# SEGURIDAD Y TOKEN
# ==========================================
JWT_SECRET=super_secret_jwt_key_mi_alberdi_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_mi_alberdi_2026
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
CORS_ORIGIN=http://localhost:3000

# ==========================================
# ALMACENAMIENTO DE ARCHIVOS (MINIO / S3)
# ==========================================
MINIO_ROOT_USER=mialberdi_minio_admin
MINIO_ROOT_PASSWORD=mialberdi_minio_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=mialberdi_minio_admin
S3_SECRET_KEY=mialberdi_minio_secret
S3_BUCKET=mi-alberdi-archivos
S3_REGION=us-east-1
# ==========================================
# MERCADO PAGO (SANDBOX / PRODUCCIÓN)
# ==========================================
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_WEBHOOK_SECRET=
MP_SUCCESS_URL=http://localhost:3000/planes?status=success
MP_FAILURE_URL=http://localhost:3000/planes?status=failure
MP_PENDING_URL=http://localhost:3000/planes?status=pending
MP_WEBHOOK_URL=http://localhost:4000/api/membresias/pagos/webhook/mercadopago

